<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>tealeaf-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>leaflet-compat</artifactId>
  <name>gwty-leaflet for TeaVM</name>
  <properties>
    <gwty.leaflet.version>1.2.1</gwty.leaflet.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>leaflet</artifactId>
      <version>${leaflet.version}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>elemental2-compat</artifactId>
      <version>${elemental2.compat.version}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
      <version>${compat.version}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>jsinterop-base-compat</artifactId>
      <version>${compat.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.jsinterop</groupId>
      <artifactId>jsinterop-annotations</artifactId>
      <version>${jsinterop.annotations.version}</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.build.directory}/teavm-sources</sourceDirectory>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>META-INF/LICENSE</include>
          <include>META-INF/NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-resources-compat-maven-plugin</artifactId>
        <version>${compat.version}</version>
        <executions>
          <execution>
            <id>adapt-gwty-leaflet</id>
            <goals>
              <goal>adapt-sources</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.basedir}/src/main/java</sourceRoot>
              <outputRoot>${project.build.directory}/teavm-sources</outputRoot>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
